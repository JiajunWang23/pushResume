{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Resume data for a user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "description": "Internal name for the resume" },
        "data": { "type": "object", "description": "The ResumeData object" },
        "slug": { "type": "string", "description": "Unique URL slug for sharing" },
        "isPublic": { "type": "boolean" },
        "viewCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "data", "slug"]
    },
    "View": {
      "title": "View",
      "description": "A single view event for a resume",
      "type": "object",
      "properties": {
        "resumeId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userAgent": { "type": "string" },
        "referrer": { "type": "string" }
      },
      "required": ["resumeId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Resume documents"
    },
    "/resumes/{resumeId}/views/{viewId}": {
      "schema": "View",
      "description": "View analytics for a resume"
    },
    "/slugs/{slug}": {
      "schema": { "type": "object", "properties": { "resumeId": { "type": "string" } } },
      "description": "Slug to resumeId mapping for fast lookup"
    }
  }
}
